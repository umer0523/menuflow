# MenuFlow environment — copy to server/.env and fill in. Never commit real values.
# Square SANDBOX only — never a production merchant token.

# Square SANDBOX access token — copy it from developer.squareup.com → your app →
# Credentials with the Sandbox toggle selected. Credentials are environment-specific:
# a Production token against the sandbox base URL fails with UNAUTHORIZED.
# (Backend only; the client never sees this.)
SQUARE_ACCESS_TOKEN=

# Square environment. Only "sandbox" is supported for this project.
SQUARE_ENV=sandbox

# Square sandbox API base URL. This is an API host, not a website — visiting it in a
# browser shows a 404 by design; the API lives under /v2/* and requires a bearer token.
SQUARE_BASE_URL=https://connect.squareupsandbox.com

# Backend HTTP port.
PORT=3001

# Allowed CORS origin (the Next.js client).
CLIENT_ORIGIN=http://localhost:3000
