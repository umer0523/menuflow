{
  "name": "menuflow",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-location Square menu browser (Next.js + NestJS)",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter ./client --filter ./server dev",
    "build": "pnpm --filter ./server build && pnpm --filter ./client build",
    "start": "pnpm --parallel --filter ./client --filter ./server start",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "test": "pnpm --recursive test"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
